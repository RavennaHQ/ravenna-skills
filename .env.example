# Ravenna Plugin - Environment Variables

# Required: Your Ravenna API key
# Get one at: https://ravenna.ai
RAVENNA_API_KEY=your-ravenna-api-key-here

# Optional: Override the Ravenna API URL (default: https://core.ravenna.ai/mcp)
# Useful for self-hosted instances or development environments
# RAVENNA_API_URL=https://core.ravenna.ai/mcp

# Optional: For local development
# RAVENNA_API_URL=http://localhost:3000/mcp
