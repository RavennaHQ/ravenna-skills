{
  "skills": {
    "directory": "./skills",
    "enabled": [
      "api-code-generator",
      "code-action",
      "debug-workflows"
    ],
    "autoLoad": true,
    "watch": false
  },
  "integrations": {
    "ravenna": {
      "url": "${RAVENNA_API_URL}",
      "type": "http",
      "auth": {
        "type": "bearer",
        "token": "${RAVENNA_API_KEY}"
      },
      "timeout": 30000,
      "retry": {
        "maxAttempts": 3,
        "backoff": "exponential"
      }
    }
  },
  "environment": {
    "loadFrom": [
      ".env",
      ".env.local"
    ]
  }
}
